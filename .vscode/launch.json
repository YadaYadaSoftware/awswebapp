{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Tjb.Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Tjb.Web/bin/Debug/net10.0/Tjb.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Tjb.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Launch Tjb.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Tjb.Api/bin/Debug/net10.0/Tjb.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Tjb.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:5001"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Launch Tjb (API + Web)",
            "type": "compound",
            "configurations": [
                "Launch Tjb.Api",
                "Launch Tjb.Web"
            ]
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}