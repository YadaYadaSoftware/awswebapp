{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch TaskManager.Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/TaskManager.Web/bin/Debug/net10.0/TaskManager.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/TaskManager.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5002;https://localhost:5003"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Launch TaskManager.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/TaskManager.Api/bin/Debug/net10.0/TaskManager.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/TaskManager.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5000;https://localhost:5001"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Launch TaskManager (API + Web)",
            "type": "compound",
            "configurations": [
                "Launch TaskManager.Api",
                "Launch TaskManager.Web"
            ]
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}