<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/YadaYadaSoftware/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <!-- %GH_PACKAGES_TOKEN% is expanded from the environment at restore time (CI sets it to the
         workflow GITHUB_TOKEN; set it locally to a PAT with read:packages to restore the Tjb.* feed).
         If the variable is unset, the github source is simply never authenticated — restores that
         only need nuget.org (e.g. ProjectReference-only builds) are unaffected. -->
    <github>
      <add key="Username" value="YadaYadaSoftware" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Tjb.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
