<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packages the project-agnostic CloudFormation templates in infrastructure/ for
    reuse by other .NET web-app projects (openspec change: make-deployment-stack-reusable).
    WORKING/PREVIEW package name — the final id is a human decision (task 1.2) and is
    NOT locked until a v1.0.0 tag on `app`. This is a content-only package (no build
    output); the templates land under contentFiles/any/any/infrastructure/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: no lib/ref assemblies — expected for a content-only package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>YadaYada.AwsWebApp.DeploymentStack</PackageId>
    <Title>YadaYada AWS Web App Deployment Stack (templates)</Title>
    <Authors>YadaYada Software</Authors>
    <Description>Reusable CloudFormation templates (bootstrap + multi-region env stacks: Aurora Serverless v2 + ECS Fargate behind an ALB) for deploying a .NET web app to AWS. Consumed alongside the YadaYadaSoftware/awswebapp reusable deploy workflow. PREVIEW — see the make-deployment-stack-reusable OpenSpec change.</Description>
    <PackageTags>aws;cloudformation;deployment;dotnet;fargate;aurora;ecs</PackageTags>
    <RepositoryUrl>https://github.com/YadaYadaSoftware/awswebapp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every template in the repo's infrastructure/ directory is the source of truth. -->
    <Content Include="..\..\infrastructure\**\*">
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/infrastructure/</PackagePath>
      <PackageCopyToOutput>false</PackageCopyToOutput>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Link>infrastructure/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
