@page "/guestbook"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject SampleDbContext Db
@inject AuthenticationStateProvider AuthState

<PageTitle>Guestbook</PageTitle>

<h1>Guestbook</h1>

<EditForm Model="@_input" OnValidSubmit="AddEntryAsync">
    <InputText @bind-Value="_input.Message" placeholder="Leave a message" />
    <button type="submit" class="btn btn-primary">Sign</button>
</EditForm>

@if (_entries is null)
{
    <p><em>Loading…</em></p>
}
else if (_entries.Count == 0)
{
    <p>No entries yet — be the first.</p>
}
else
{
    <ul>
        @foreach (var entry in _entries)
        {
            <li>@entry.CreatedUtc.ToString("u") — @entry.Message</li>
        }
    </ul>
}

@code {
    private List<GuestbookEntry>? _entries;
    private readonly InputModel _input = new();
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadAsync();
    }

    private async Task LoadAsync()
        => _entries = await Db.GuestbookEntries
            .OrderByDescending(e => e.CreatedUtc)
            .Take(50)
            .ToListAsync();

    private async Task AddEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(_input.Message) || _userId is null)
        {
            return;
        }

        Db.GuestbookEntries.Add(new GuestbookEntry
        {
            AuthorUserId = _userId,
            Message = _input.Message.Trim(),
            CreatedUtc = DateTime.UtcNow
        });
        await Db.SaveChangesAsync();

        _input.Message = string.Empty;
        await LoadAsync();
    }

    private sealed class InputModel
    {
        public string Message { get; set; } = string.Empty;
    }
}
