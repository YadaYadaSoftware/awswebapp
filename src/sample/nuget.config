<?xml version="1.0" encoding="utf-8"?>
<!--
  The sample is a standalone consumer: it restores the framework packages
  (Tjb.Web.Framework / Tjb.Web.Hosting / Tjb.Web.Framework.Data) from this org's
  GitHub Packages feed, and everything else from nuget.org. This file is committed
  under src/sample so the sample stands on its own (as a real consumer repo would),
  not relying on the repo-root NuGet.config.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/YadaYadaSoftware/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <!-- %GH_PACKAGES_TOKEN% is expanded from the environment at restore time. Locally, set it to
         a PAT with read:packages scope (see README.md); in CI it is the workflow GITHUB_TOKEN. -->
    <github>
      <add key="Username" value="YadaYadaSoftware" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Tjb.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
