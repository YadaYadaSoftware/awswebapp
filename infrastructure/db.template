---
AWSTemplateFormatVersion: 2010-09-09
Description: "Regional Database Infrastructure - Aurora Clusters, RDS Resources. Identifiers and secret paths derive from DomainName (dot form): dashed form for cluster IDs / Secrets paths, underscored form for MySQL master username (MySQL disallows hyphens)."

Parameters:
  DatabasePassword:
    Type: String
    NoEcho: true
    MinLength: 8
    Description: Password for the Aurora MySQL database

  DomainName:
    Type: String
    Description: "Domain name in dot form (e.g. appcloud.systems). Derived to dashed/underscored forms locally."

  EngineVersion:
    Type: String
    Description: Aurora MySQL engine version for the regional cluster

  AuroraGlobalClusterId:
    Type: String
    Description: ID of the Aurora global cluster from global stack

  AuroraKmsKeyArn:
    Type: String
    Description: ARN of the KMS key (primary or replica) for Aurora encryption in this region

  AuroraClusterDeleteHandlerArn:
    Type: String
    Description: "ARN of the bootstrap-owned Aurora cluster force-teardown Lambda for this region. Sourced by the deploy workflow from /{dashed-domain}/lambda/aurora-cluster-delete-handler-arn in SSM and threaded through master -> backend. Used as the AuroraClusterDrainOnDelete custom resource's ServiceToken."

  IsPrimaryRegion:
    Type: String
    AllowedValues: ["true", "false"]
    Default: "false"
    Description: Whether this region hosts the primary cluster

  EnableGlobalCluster:
    Type: String
    AllowedValues: ["true", "false"]
    Default: "true"
    Description: Whether to enable Aurora global cluster (for multi-region deployments)

  BranchName:
    Type: String
    Description: Branch name for resource naming

  EnvironmentToImport:
    Type: String
    Description: Branch name to import infrastructure values from

  MinCapacity:
    Type: Number
    Default: 0
    Description: Minimum Aurora Serverless v2 capacity (ACUs)

  MaxCapacity:
    Type: Number
    Default: 1
    Description: Maximum Aurora Serverless v2 capacity (ACUs)

Conditions:
  IsPrimary: !Equals [!Ref IsPrimaryRegion, "true"]
  IsNotPrimary: !Equals [!Ref IsPrimaryRegion, "false"]
  EnableGlobal: !Equals [!Ref EnableGlobalCluster, "true"]
  ShouldCreateGlobalCluster:
    !And [
      !Equals [!Ref IsPrimaryRegion, "true"],
      !Equals [!Ref EnableGlobalCluster, "true"],
    ]
  IsDevBetaOrAlpha:
    !Or [
      !Equals [!Ref EnvironmentToImport, "dev"],
      !Equals [!Ref EnvironmentToImport, "beta"],
      !Equals [!Ref EnvironmentToImport, "alpha"],
    ]

Resources:
  # Aurora DB Subnet Group
  AuroraDBSubnetGroup:
    Type: AWS::RDS::DBSubnetGroup
    Properties:
      DBSubnetGroupDescription: "Subnet group for Aurora cluster in this region"
      SubnetIds:
        - Fn::ImportValue: !Sub
            - "PrivateSubnet1Id-${EnvironmentToImport}-${DomainDashed}"
            - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]
        - Fn::ImportValue: !Sub
            - "PrivateSubnet2Id-${EnvironmentToImport}-${DomainDashed}"
            - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]
  # Aurora DB Cluster Parameter Group
  AuroraClusterParameterGroup:
    Type: AWS::RDS::DBClusterParameterGroup
    Properties:
      Family: aurora-mysql8.0
      Description: "Parameter group for Aurora MySQL cluster"
      Parameters:
        character_set_server: utf8mb4
        collation_server: utf8mb4_unicode_ci
        innodb_buffer_pool_size: "{DBInstanceClassMemory*3/4}"
        max_connections: "200"
        slow_query_log: "1"
        long_query_time: "2"

  # Aurora Serverless v2 Cluster
  AuroraCluster:
    Type: AWS::RDS::DBCluster
    Properties:
      # No explicit DBClusterIdentifier — CFN auto-names the cluster. An explicit
      # name forces REPLACEMENT on existing stacks AND changes the DatabaseHost
      # export, which CFN refuses while Web/Api/feature-branch stacks import it,
      # so the whole stack update rolls back (observed on dev 2026-06-05). The
      # teardown Lambda doesn't need a predictable name: the
      # AuroraClusterDrainOnDelete custom resource below passes the resolved
      # cluster id (!Ref AuroraCluster) into the Lambda, whose IAM policy is
      # scoped to rds cluster:*/db:* precisely because auto-names can't be
      # prefix-matched (see bootstrap.template).
      GlobalClusterIdentifier:
        !If [
          IsPrimary,
          !If [
            ShouldCreateGlobalCluster,
            !Ref AuroraGlobalCluster,
            !Ref "AWS::NoValue",
          ],
          !If [EnableGlobal, !Ref AuroraGlobalClusterId, !Ref "AWS::NoValue"],
        ]
      Engine: aurora-mysql
      EngineVersion: !Ref EngineVersion
      MasterUsername: !If
        - IsPrimary
        - !Sub
          - "${DomainUnderscored}_admin"
          - DomainUnderscored: !Join ["_", !Split [".", !Ref DomainName]]
        - !Ref "AWS::NoValue"
      MasterUserPassword:
        !If [IsPrimary, !Ref DatabasePassword, !Ref "AWS::NoValue"]
      DatabaseName: !If [IsPrimary, !Ref BranchName, !Ref "AWS::NoValue"]
      DBClusterParameterGroupName: !Ref AuroraClusterParameterGroup
      DBSubnetGroupName: !Ref AuroraDBSubnetGroup
      VpcSecurityGroupIds:
        - Fn::ImportValue: !Sub
            - "RDSSecurityGroupId-${EnvironmentToImport}-${DomainDashed}"
            - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]
      BackupRetentionPeriod: 7
      PreferredBackupWindow: "03:00-04:00"
      PreferredMaintenanceWindow: "sun:04:00-sun:05:00"
      StorageEncrypted: true
      KmsKeyId: !Ref AuroraKmsKeyArn
      DeletionProtection: false
      ServerlessV2ScalingConfiguration:
        MinCapacity: !Ref MinCapacity
        MaxCapacity: !Ref MaxCapacity
      EnableCloudwatchLogsExports:
        - audit
        - error
        - general
        - slowquery
      EnableHttpEndpoint: !If [IsDevBetaOrAlpha, true, false]
  # Aurora Serverless v2 Instance
  AuroraInstance:
    Type: AWS::RDS::DBInstance
    Properties:
      # No explicit DBInstanceIdentifier (CFN auto-names it) — same rationale as
      # the cluster above: avoids replacement, and the teardown Lambda is scoped
      # to db:* rather than a name prefix.
      DBClusterIdentifier: !Ref AuroraCluster
      DBInstanceClass: db.serverless
      Engine: aurora-mysql
      PubliclyAccessible: false

  # Force-drain backstop for stack deletes. On Create/Update the backing Lambda
  # is a no-op; its only job is the Delete path. DependsOn: AuroraCluster is
  # LOAD-BEARING: CFN deletes resources in reverse creation order, so declaring
  # this resource as depending on the cluster makes CFN delete THIS resource
  # FIRST on a stack delete. The Lambda drains the (possibly stuck) cluster, and
  # CFN's own subsequent AWS::RDS::DBCluster delete then finds it already gone
  # and succeeds — instead of deadlocking the AuroraDBSubnetGroup delete. Do NOT
  # remove the DependsOn, and do NOT delete this resource from a stack that
  # still has a live cluster (that would trigger an unintended drain).
  AuroraClusterDrainOnDelete:
    Type: Custom::AuroraClusterDrainOnDelete
    DependsOn: AuroraCluster
    Properties:
      ServiceToken: !Ref AuroraClusterDeleteHandlerArn
      ClusterIdentifier: !Ref AuroraCluster

  AuroraGlobalCluster:
    Condition: ShouldCreateGlobalCluster
    Type: AWS::RDS::GlobalCluster
    Properties:
      GlobalClusterIdentifier: !Sub
        - "${DomainDashed}-${BranchName}-global-cluster"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]
      Engine: aurora-mysql
      EngineVersion: !Ref EngineVersion
      DeletionProtection: false
      StorageEncrypted: true
  # Database Password Secret (only password remains sensitive)
  DatabasePasswordSecret:
    Type: AWS::SecretsManager::Secret
    Properties:
      Name: !Sub
        - "${DomainDashed}/database/${BranchName}/regional/${AWS::Region}/password"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]
      Description: Database password for Aurora Regional Cluster
      SecretString: !Ref DatabasePassword
Outputs:
  AuroraClusterId:
    Description: Aurora Regional Cluster ID
    Value: !Ref AuroraCluster
    Export:
      Name: !Sub "AuroraClusterId-${BranchName}"

  AuroraClusterIdDomainQualified:
    Description: Aurora Regional Cluster ID
    Value: !Ref AuroraCluster
    Export:
      Name: !Sub
        - "AuroraClusterId-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabaseEndpoint:
    Description: Aurora MySQL cluster endpoint
    Value: !GetAtt AuroraCluster.Endpoint.Address
    Export:
      Name: !Sub "DatabaseEndpoint-${BranchName}"

  DatabaseEndpointDomainQualified:
    Description: Aurora MySQL cluster endpoint
    Value: !GetAtt AuroraCluster.Endpoint.Address
    Export:
      Name: !Sub
        - "DatabaseEndpoint-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabaseReaderEndpoint:
    Description: Aurora MySQL reader endpoint
    Value: !GetAtt AuroraCluster.ReadEndpoint.Address
    Export:
      Name: !Sub "DatabaseReaderEndpoint-${BranchName}"

  DatabaseReaderEndpointDomainQualified:
    Description: Aurora MySQL reader endpoint
    Value: !GetAtt AuroraCluster.ReadEndpoint.Address
    Export:
      Name: !Sub
        - "DatabaseReaderEndpoint-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabaseUsername:
    Description: Database username
    Value: !Sub
      - "${DomainUnderscored}_admin"
      - DomainUnderscored: !Join ["_", !Split [".", !Ref DomainName]]
    Export:
      Name: !Sub "DatabaseUsername-${BranchName}"

  DatabaseUsernameDomainQualified:
    Description: Database username
    Value: !Sub
      - "${DomainUnderscored}_admin"
      - DomainUnderscored: !Join ["_", !Split [".", !Ref DomainName]]
    Export:
      Name: !Sub
        - "DatabaseUsername-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabaseEngine:
    Description: Database engine
    Value: "aurora-mysql"
    Export:
      Name: !Sub "DatabaseEngine-${BranchName}"

  DatabaseEngineDomainQualified:
    Description: Database engine
    Value: "aurora-mysql"
    Export:
      Name: !Sub
        - "DatabaseEngine-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabaseHost:
    Description: Database host endpoint
    Value: !GetAtt AuroraCluster.Endpoint.Address
    Export:
      Name: !Sub "DatabaseHost-${BranchName}"

  DatabaseHostDomainQualified:
    Description: Database host endpoint
    Value: !GetAtt AuroraCluster.Endpoint.Address
    Export:
      Name: !Sub
        - "DatabaseHost-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabasePort:
    Description: Database port
    Value: !GetAtt AuroraCluster.Endpoint.Port
    Export:
      Name: !Sub "DatabasePort-${BranchName}"

  DatabasePortDomainQualified:
    Description: Database port
    Value: !GetAtt AuroraCluster.Endpoint.Port
    Export:
      Name: !Sub
        - "DatabasePort-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabaseName:
    Description: Database name
    Value: !Ref BranchName
    Export:
      Name: !Sub "DatabaseName-${BranchName}"

  DatabaseNameDomainQualified:
    Description: Database name
    Value: !Ref BranchName
    Export:
      Name: !Sub
        - "DatabaseName-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabaseClusterArn:
    Description: Database cluster ARN
    Value: !Ref AuroraCluster
    Export:
      Name: !Sub "DatabaseClusterArn-${BranchName}"

  DatabaseClusterArnDomainQualified:
    Description: Database cluster ARN
    Value: !Ref AuroraCluster
    Export:
      Name: !Sub
        - "DatabaseClusterArn-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  DatabasePasswordSecretArn:
    Description: Database password secret ARN
    Value: !Ref DatabasePasswordSecret
    Export:
      Name: !Sub "DatabasePasswordSecretArn-${BranchName}"

  DatabasePasswordSecretArnDomainQualified:
    Description: Database password secret ARN
    Value: !Ref DatabasePasswordSecret
    Export:
      Name: !Sub
        - "DatabasePasswordSecretArn-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]

  AuroraGlobalClusterId:
    Condition: ShouldCreateGlobalCluster
    Description: Aurora Global Database cluster identifier
    Value: !Ref AuroraGlobalCluster
    Export:
      Name: !Sub "AuroraGlobalClusterId-${BranchName}"

  AuroraGlobalClusterIdDomainQualified:
    Condition: ShouldCreateGlobalCluster
    Description: Aurora Global Database cluster identifier
    Value: !Ref AuroraGlobalCluster
    Export:
      Name: !Sub
        - "AuroraGlobalClusterId-${BranchName}-${DomainDashed}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]
