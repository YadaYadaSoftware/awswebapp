AWSTemplateFormatVersion: "2010-09-09"
Transform: AWS::Serverless-2016-10-31
Description: "TaskManager API - Lambda Function with Branch-Specific Database"

Parameters:
  BranchName:
    Type: String
    Description: "Branch name for resource naming"

  EnvironmentToImport:
    Type: String
    Description: "Branch name to import infrastructure values from"

  Environment:
    Type: String
    Default: "Development"
    Description: "ASP.NET Core environment (Production, Staging, Development)"

Globals:
  Function:
    Runtime: dotnet8
    Timeout: 60
    MemorySize: 512
    Environment:
      Variables:
        ASPNETCORE_ENVIRONMENT: !Ref Environment
  Api:
    AccessLogSetting:
      Format: '{"requestId":"$context.requestId","ip":"$context.identity.sourceIp","caller":"$context.identity.caller","user":"$context.identity.user","requestTime":"$context.requestTime","httpMethod":"$context.httpMethod","resourcePath":"$context.resourcePath","status":"$context.status","protocol":"$context.protocol","responseLength":"$context.responseLength"}'
    MethodSettings:
      - HttpMethod: "*"
        ResourcePath: "/*"
        LoggingLevel: INFO
        DataTraceEnabled: true

Resources:
  # TaskManager API Function
  TaskManagerApiFunction:
    Type: AWS::Serverless::Function
    Properties:
      CodeUri: ../src/TaskManager.Api/
      Handler: >-
        TaskManager.Api::TaskManager.Api.LambdaEntryPoint::FunctionHandlerAsync
      Runtime: dotnet8
      PackageType: Zip
      Role:
        Fn::ImportValue: !Sub "SharedLambdaRoleArn-${EnvironmentToImport}"
      Environment:
        Variables:
          ASPNETCORE_ENVIRONMENT: !Ref Environment
          ConnectionStrings__DefaultConnection: !Sub
            - "Server=${DatabaseHost};Database=${DatabaseName};User Id=${DatabaseUsername};Password=${DatabasePassword};SslMode=Required;"
            - DatabaseHost:
                Fn::ImportValue: !Sub "DatabaseHost-${EnvironmentToImport}"
              DatabaseName:
                Fn::ImportValue: !Sub "DatabaseName-${EnvironmentToImport}"
              DatabaseUsername:
                Fn::ImportValue: !Sub "DatabaseUsername-${EnvironmentToImport}"
              DatabasePassword: !Sub "{{resolve:secretsmanager:taskmanager/database/${EnvironmentToImport}/regional/${AWS::Region}/password:SecretString}}"
      VpcConfig:
        SecurityGroupIds:
          - Fn::ImportValue: !Sub "LambdaSecurityGroupId-${EnvironmentToImport}"
        SubnetIds:
          - Fn::ImportValue: !Sub "PrivateSubnet1Id-${EnvironmentToImport}"
          - Fn::ImportValue: !Sub "PrivateSubnet2Id-${EnvironmentToImport}"
      Events:
        # Health check endpoint for deployment verification
        HealthCheck:
          Type: Api
          Properties:
            Path: /health
            Method: GET
        # Main API routes for application functionality
        ApiGatewayProxy:
          Type: Api
          Properties:
            Path: /api/{proxy+}
            Method: ANY

  # CloudWatch Alarms for API
  LambdaErrorAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmDescription: "API Lambda function error rate alarm"
      MetricName: Errors
      Namespace: AWS/Lambda
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 2
      Threshold: 5
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
        - Name: FunctionName
          Value: !Ref TaskManagerApiFunction
Outputs:
  ApiEndpoint:
    Description: "API Gateway endpoint URL"
    Value: !Sub
      - "https://${ApiId}.execute-api.${Region}.amazonaws.com/Prod/"
      - ApiId: !Ref ServerlessRestApi
        Region: !Ref AWS::Region
    Export:
      Name: !Sub "ApiEndpoint-${BranchName}"

  ApiLambdaFunctionName:
    Description: "API Lambda function name"
    Value: !Ref TaskManagerApiFunction
    Export:
      Name: !Sub "ApiLambdaFunctionName-${BranchName}"
