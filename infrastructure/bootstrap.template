AWSTemplateFormatVersion: "2010-09-09"
Description: "TaskManager Per-Scope Bootstrap - Aurora KMS key (primary or replica) plus scope-specific GitHub Actions IAM user. Scope is derived from the stack name: any stack whose name contains 'nonprod' gets the nonprod scope; all others get prod. Primary vs replica is derived from whether the PrimaryKeyArn parameter is empty (primary, default) or non-empty (replica). Intended stack names: 'bootstrap-prod' and 'bootstrap-nonprod', deployed once per region."

Parameters:
  PrimaryKeyArn:
    Type: String
    Default: ""
    Description: "ARN of the primary multi-region KMS key. Leave empty (default) for the primary-region deploy; for the secondary region, pass the AuroraKmsKeyArn output from the primary-region deploy of the same scope. Presence determines IsPrimary/IsReplica."

Conditions:
  # IsNonprod is true iff the stack name contains the substring "nonprod".
  # Join-after-Split is an identity transform iff the delimiter is absent, so
  # the rejoined string differs from the original exactly when "nonprod" was
  # present (and got removed by Split). This is the CFN workaround for the
  # missing Fn::Contains intrinsic.
  IsNonprod:
    !Not
    - !Equals
      - !Join ["", !Split ["nonprod", !Ref "AWS::StackName"]]
      - !Ref "AWS::StackName"
  IsProd:
    !Equals
    - !Join ["", !Split ["nonprod", !Ref "AWS::StackName"]]
    - !Ref "AWS::StackName"
  IsPrimary: !Equals [!Ref PrimaryKeyArn, ""]
  IsReplica: !Not [!Equals [!Ref PrimaryKeyArn, ""]]
  IsProdPrimary:
    !And
    - !Equals [!Ref PrimaryKeyArn, ""]
    - !Equals
      - !Join ["", !Split ["nonprod", !Ref "AWS::StackName"]]
      - !Ref "AWS::StackName"
  IsNonprodPrimary:
    !And
    - !Equals [!Ref PrimaryKeyArn, ""]
    - !Not
      - !Equals
        - !Join ["", !Split ["nonprod", !Ref "AWS::StackName"]]
        - !Ref "AWS::StackName"

Resources:
  AuroraKmsKey:
    Type: AWS::KMS::Key
    Condition: IsPrimary
    Properties:
      Description: !If [IsNonprod, "TaskManager Aurora encryption key (nonprod)", "TaskManager Aurora encryption key (prod)"]
      KeyUsage: ENCRYPT_DECRYPT
      KeySpec: SYMMETRIC_DEFAULT
      MultiRegion: true
      Enabled: true
      PendingWindowInDays: 7
      # Principals referenced by !GetAtt so CFN creates the IAM resources
      # before the key (KMS validates principal existence at key creation,
      # unlike S3 bucket policies which defer). Only the !If branch matching
      # the deploy scope is evaluated, so the prod-branch !GetAtt to
      # GitHubActionsUserProd is harmless on nonprod deploys.
      KeyPolicy: !If
        - IsProd
        - Version: "2012-10-17"
          Statement:
            - Sid: AllowAccountRoot
              Effect: Allow
              Principal:
                AWS: !Sub "arn:aws:iam::${AWS::AccountId}:root"
              Action: kms:*
              Resource: "*"
            - Sid: AllowRDSService
              Effect: Allow
              Principal:
                Service: rds.amazonaws.com
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
              Resource: "*"
            - Sid: AllowGitHubActionsUserProd
              Effect: Allow
              Principal:
                AWS: !GetAtt GitHubActionsUserProd.Arn
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
                - kms:ListGrants
                - kms:RevokeGrant
              Resource: "*"
            - Sid: AllowProdKmsAdmin
              Effect: Allow
              Principal:
                AWS: !GetAtt ProdKmsAdminRole.Arn
              Action: kms:*
              Resource: "*"
        - Version: "2012-10-17"
          Statement:
            - Sid: AllowAccountRoot
              Effect: Allow
              Principal:
                AWS: !Sub "arn:aws:iam::${AWS::AccountId}:root"
              Action: kms:*
              Resource: "*"
            - Sid: AllowRDSService
              Effect: Allow
              Principal:
                Service: rds.amazonaws.com
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
              Resource: "*"
            - Sid: AllowGitHubActionsUser
              Effect: Allow
              Principal:
                AWS: !GetAtt GitHubActionsUser.Arn
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
                - kms:CreateAlias
                - kms:DeleteAlias
                - kms:UpdateAlias
                - kms:ListAliases
                - kms:ListGrants
                - kms:RevokeGrant
              Resource: "*"

  AuroraKmsKeyReplica:
    Type: AWS::KMS::ReplicaKey
    Condition: IsReplica
    Properties:
      Description: !If [IsNonprod, "TaskManager Aurora encryption key replica (nonprod)", "TaskManager Aurora encryption key replica (prod)"]
      PrimaryKeyArn: !Ref PrimaryKeyArn
      Enabled: true
      PendingWindowInDays: 7
      # Principals referenced by !Sub'd ARN because the IAM users/role
      # don't exist in this stack — they were created by the primary
      # (us-east-1) deploy of the same scope. By the time us-west-2 is
      # deployed, those principals already exist in IAM (which is global),
      # so KMS principal validation passes.
      KeyPolicy: !If
        - IsProd
        - Version: "2012-10-17"
          Statement:
            - Sid: AllowAccountRoot
              Effect: Allow
              Principal:
                AWS: !Sub "arn:aws:iam::${AWS::AccountId}:root"
              Action: kms:*
              Resource: "*"
            - Sid: AllowRDSService
              Effect: Allow
              Principal:
                Service: rds.amazonaws.com
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
              Resource: "*"
            - Sid: AllowGitHubActionsUserProd
              Effect: Allow
              Principal:
                AWS: !Sub "arn:aws:iam::${AWS::AccountId}:user/GitHubActionsUserProd"
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
                - kms:ListGrants
                - kms:RevokeGrant
              Resource: "*"
            - Sid: AllowProdKmsAdmin
              Effect: Allow
              Principal:
                AWS: !Sub "arn:aws:iam::${AWS::AccountId}:role/prod-kms-admin"
              Action: kms:*
              Resource: "*"
        - Version: "2012-10-17"
          Statement:
            - Sid: AllowAccountRoot
              Effect: Allow
              Principal:
                AWS: !Sub "arn:aws:iam::${AWS::AccountId}:root"
              Action: kms:*
              Resource: "*"
            - Sid: AllowRDSService
              Effect: Allow
              Principal:
                Service: rds.amazonaws.com
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
              Resource: "*"
            - Sid: AllowGitHubActionsUser
              Effect: Allow
              Principal:
                AWS: !Sub "arn:aws:iam::${AWS::AccountId}:user/GitHubActionsUser"
              Action:
                - kms:CreateGrant
                - kms:DescribeKey
                - kms:Decrypt
                - kms:Encrypt
                - kms:GenerateDataKey
                - kms:ReEncryptFrom
                - kms:ReEncryptTo
                - kms:RetireGrant
                - kms:CreateAlias
                - kms:DeleteAlias
                - kms:UpdateAlias
                - kms:ListAliases
                - kms:ListGrants
                - kms:RevokeGrant
              Resource: "*"

  AuroraKmsKeyAlias:
    Type: AWS::KMS::Alias
    Properties:
      AliasName: !If [IsNonprod, "alias/taskmanager-aurora-nonprod", "alias/taskmanager-aurora-prod"]
      TargetKeyId: !If [IsPrimary, !Ref AuroraKmsKey, !Ref AuroraKmsKeyReplica]

  AuroraKmsKeyArnParameter:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !If [IsNonprod, "/taskmanager/kms/nonprod/aurora-key-arn", "/taskmanager/kms/prod/aurora-key-arn"]
      Type: String
      Description: !If [IsNonprod, "ARN of the nonprod Aurora KMS key (or replica) in this region. Populated by bootstrap-nonprod; consumed by the deploy workflow's SSM lookup step.", "ARN of the prod Aurora KMS key (or replica) in this region. Populated by bootstrap-prod; consumed by the deploy workflow's SSM lookup step."]
      Value: !If [IsPrimary, !GetAtt AuroraKmsKey.Arn, !GetAtt AuroraKmsKeyReplica.Arn]

  # ---------- IAM resources (primary region only; IAM is global) ----------

  GitHubActionsUser:
    Type: AWS::IAM::User
    Condition: IsNonprodPrimary
    Properties:
      # Explicit name so bootstrap-shared.template's TemplatesBucketPolicy
      # can reference this user by hardcoded ARN without a cross-stack import.
      UserName: GitHubActionsUser

  GitHubActionsAccessKey:
    Type: AWS::IAM::AccessKey
    Condition: IsNonprodPrimary
    Properties:
      UserName: !Ref GitHubActionsUser

  DeploymentPolicy:
    Type: AWS::IAM::Policy
    Condition: IsNonprodPrimary
    Properties:
      PolicyName: !Sub "DeploymentPolicy-${AWS::Region}"
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - cloudformation:*
              - lambda:*
              - apigateway:*
              - rds:*
              - ec2:*
              - secretsmanager:*
              - logs:*
              - cloudwatch:*
              - s3:*
              - sns:*
              - ecs:*
              - ecr:*
              - elasticloadbalancing:*
              - acm:*
              - route53:*
              - iam:*
              - ssm:GetParameter
              - ssm:GetParameters
              - config:*
            Resource: "*"
          - Effect: Allow
            Action:
              - iam:CreateServiceLinkedRole
            Resource: "*"
            Condition:
              StringEquals:
                iam:AWSServiceName:
                  - elasticloadbalancing.amazonaws.com
                  - ecs.amazonaws.com
          - Effect: Allow
            Action:
              - kms:CreateKey
              - kms:DescribeKey
              - kms:CreateGrant
              - kms:Decrypt
              - kms:Encrypt
              - kms:GenerateDataKey
              - kms:ReEncryptFrom
              - kms:ReEncryptTo
              - kms:RetireGrant
              - kms:CreateAlias
              - kms:DeleteAlias
              - kms:UpdateAlias
              - kms:ListAliases
              - kms:ListGrants
              - kms:RevokeGrant
              - kms:PutKeyPolicy
              - kms:ReplicateKey
              - kms:ScheduleKeyDeletion
              - kms:GetKeyPolicy
            Resource: "*"
          - Effect: Allow
            Action:
              - ec2:CreateTags
              - ec2:DeleteTags
              - ec2:DescribeTags
              - rds:AddTagsToResource
              - rds:RemoveTagsFromResource
              - rds:DescribeDBInstances
              - rds:DescribeDBClusters
              - lambda:TagResource
              - lambda:UntagResource
              - lambda:ListTags
              - logs:TagLogGroup
              - logs:UntagLogGroup
              - logs:ListTagsLogGroup
              - ecr:TagResource
              - ecr:UntagResource
              - ecr:ListTagsForResource
              - ecs:TagResource
              - ecs:UntagResource
              - ecs:ListTagsForResource
              - elasticloadbalancing:AddTags
              - elasticloadbalancing:RemoveTags
              - elasticloadbalancing:DescribeTags
              - secretsmanager:TagResource
              - secretsmanager:UntagResource
              - secretsmanager:DescribeSecret
              - kms:TagResource
              - kms:UntagResource
              - kms:ListResourceTags
              - s3:PutBucketTagging
              - s3:GetBucketTagging
              - s3:DeleteBucketTagging
              - route53:ChangeTagsForResource
              - route53:ListTagsForResource
              - acm:AddTagsToCertificate
              - acm:RemoveTagsFromCertificate
              - acm:ListTagsForCertificate
              - cloudwatch:TagResource
              - cloudwatch:UntagResource
              - cloudwatch:ListTagsForResource
            Resource: "*"
          - Effect: Allow
            Action:
              - sts:GetCallerIdentity
              - sts:AssumeRole
            Resource: "*"
      Users:
        - !Ref GitHubActionsUser

  GitHubActionsUserProd:
    Type: AWS::IAM::User
    Condition: IsProdPrimary
    Properties:
      UserName: GitHubActionsUserProd

  GitHubActionsAccessKeyProd:
    Type: AWS::IAM::AccessKey
    Condition: IsProdPrimary
    Properties:
      UserName: !Ref GitHubActionsUserProd

  DeploymentPolicyProd:
    Type: AWS::IAM::Policy
    Condition: IsProdPrimary
    Properties:
      PolicyName: !Sub "DeploymentPolicy-prod-${AWS::Region}"
      # Mirror of nonprod DeploymentPolicy shape, with one tightening:
      # the KMS statement is restricted to the prod key only (Resource:
      # AuroraKmsKey.Arn rather than "*") and excludes the destructive
      # ops (PutKeyPolicy, ScheduleKeyDeletion). The bootstrap-prod key's
      # own policy enforces this too — the IAM tightening is defense in
      # depth.
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - cloudformation:*
              - lambda:*
              - apigateway:*
              - rds:*
              - ec2:*
              - secretsmanager:*
              - logs:*
              - cloudwatch:*
              - s3:*
              - sns:*
              - ecs:*
              - ecr:*
              - elasticloadbalancing:*
              - acm:*
              - route53:*
              - iam:*
              - ssm:GetParameter
              - ssm:GetParameters
              - config:*
            Resource: "*"
          - Effect: Allow
            Action:
              - iam:CreateServiceLinkedRole
            Resource: "*"
            Condition:
              StringEquals:
                iam:AWSServiceName:
                  - elasticloadbalancing.amazonaws.com
                  - ecs.amazonaws.com
          - Effect: Allow
            Action:
              - kms:DescribeKey
              - kms:CreateGrant
              - kms:Decrypt
              - kms:Encrypt
              - kms:GenerateDataKey
              - kms:ReEncryptFrom
              - kms:ReEncryptTo
              - kms:RetireGrant
              - kms:ListAliases
              - kms:ListGrants
              - kms:RevokeGrant
              - kms:GetKeyPolicy
            Resource: !GetAtt AuroraKmsKey.Arn
          - Effect: Allow
            Action:
              - ec2:CreateTags
              - ec2:DeleteTags
              - ec2:DescribeTags
              - rds:AddTagsToResource
              - rds:RemoveTagsFromResource
              - rds:DescribeDBInstances
              - rds:DescribeDBClusters
              - lambda:TagResource
              - lambda:UntagResource
              - lambda:ListTags
              - logs:TagLogGroup
              - logs:UntagLogGroup
              - logs:ListTagsLogGroup
              - ecr:TagResource
              - ecr:UntagResource
              - ecr:ListTagsForResource
              - ecs:TagResource
              - ecs:UntagResource
              - ecs:ListTagsForResource
              - elasticloadbalancing:AddTags
              - elasticloadbalancing:RemoveTags
              - elasticloadbalancing:DescribeTags
              - secretsmanager:TagResource
              - secretsmanager:UntagResource
              - secretsmanager:DescribeSecret
              - kms:TagResource
              - kms:UntagResource
              - kms:ListResourceTags
              - s3:PutBucketTagging
              - s3:GetBucketTagging
              - s3:DeleteBucketTagging
              - route53:ChangeTagsForResource
              - route53:ListTagsForResource
              - acm:AddTagsToCertificate
              - acm:RemoveTagsFromCertificate
              - acm:ListTagsForCertificate
              - cloudwatch:TagResource
              - cloudwatch:UntagResource
              - cloudwatch:ListTagsForResource
            Resource: "*"
          - Effect: Allow
            Action:
              - sts:GetCallerIdentity
              - sts:AssumeRole
            Resource: "*"
      Users:
        - !Ref GitHubActionsUserProd

  ProdKmsAdminRole:
    Type: AWS::IAM::Role
    Condition: IsProdPrimary
    Properties:
      # Explicit name so the prod KMS key policy can reference this role
      # by hardcoded ARN, avoiding a circular !GetAtt dependency.
      RoleName: prod-kms-admin
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              AWS: !Sub "arn:aws:iam::${AWS::AccountId}:root"
            Action: sts:AssumeRole
      Policies:
        - PolicyName: !Sub "ProdKmsAdminPolicy-${AWS::Region}"
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action: kms:*
                Resource: "*"

Outputs:
  AuroraKmsKeyArn:
    Description: "ARN of the Aurora KMS key (primary or replica in this region)"
    Value: !If [IsPrimary, !GetAtt AuroraKmsKey.Arn, !GetAtt AuroraKmsKeyReplica.Arn]

  AuroraKmsKeyAliasName:
    Description: "Alias name of the Aurora KMS key (e.g. alias/taskmanager-aurora-nonprod). The alias resource has no ARN attribute exposed by CloudFormation; consumers should look up the key by alias name if needed."
    Value: !Ref AuroraKmsKeyAlias

  GitHubActionsUserAccessKeyId:
    Condition: IsNonprodPrimary
    Description: "Access Key ID for non-prod CI. Copy to AWS_ACCESS_KEY_ID GitHub secret."
    Value: !Ref GitHubActionsAccessKey

  GitHubActionsUserSecretAccessKey:
    Condition: IsNonprodPrimary
    Description: "Secret Access Key for non-prod CI. Copy to AWS_SECRET_ACCESS_KEY GitHub secret, then rotate (task 7.4)."
    Value: !GetAtt GitHubActionsAccessKey.SecretAccessKey

  GitHubActionsUserArn:
    Condition: IsNonprodPrimary
    Description: "ARN of the non-prod CI IAM user"
    Value: !GetAtt GitHubActionsUser.Arn

  GitHubActionsUserProdAccessKeyId:
    Condition: IsProdPrimary
    Description: "Access Key ID for prod CI. Copy to AWS_ACCESS_KEY_ID_PROD GitHub secret."
    Value: !Ref GitHubActionsAccessKeyProd

  GitHubActionsUserProdSecretAccessKey:
    Condition: IsProdPrimary
    Description: "Secret Access Key for prod CI. Copy to AWS_SECRET_ACCESS_KEY_PROD GitHub secret, then rotate (task 7.4)."
    Value: !GetAtt GitHubActionsAccessKeyProd.SecretAccessKey

  GitHubActionsUserProdArn:
    Condition: IsProdPrimary
    Description: "ARN of the prod CI IAM user"
    Value: !GetAtt GitHubActionsUserProd.Arn

  ProdKmsAdminRoleArn:
    Condition: IsProdPrimary
    Description: "ARN of the prod-kms-admin role (assumable by account root only)"
    Value: !GetAtt ProdKmsAdminRole.Arn
