---
AWSTemplateFormatVersion: "2010-09-09"
Description: "Global DNS Configuration for Multi-Region Failover"

Parameters:
  BranchName:
    Type: String
    Description: "Branch name for resource naming"

  DomainName:
    Type: String
    Default: "appcloud.systems"
    Description: "Domain name for SSL certificate"

  HostedZoneId:
    Type: String
    Description: "Route 53 hosted zone ID for the domain"

  PrimaryRegion:
    Type: String
    Default: ""
    Description: "Primary region for DNS failover (empty for single region)"

  SecondaryRegion:
    Type: String
    Default: ""
    Description: "Secondary region for DNS failover (empty for single region)"

  IsPrimaryRegion:
    Type: String
    AllowedValues: ["true", "false"]
    Default: "true"
    Description: "Whether this region is the primary region"

  PrimaryWebLoadBalancerDNS:
    Type: String
    Default: ""
    Description: "DNS name of the primary region's web load balancer (required for multi-region)"

  PrimaryWebLoadBalancerHostedZoneId:
    Type: String
    Default: ""
    Description: "Hosted zone ID of the primary region's web load balancer (required for multi-region)"

Conditions:
  # Single region: PrimaryWebLoadBalancerDNS is empty
  # Multi region: PrimaryWebLoadBalancerDNS is populated
  IsSingleRegion: !Equals [!Ref PrimaryWebLoadBalancerDNS, ""]
  IsMultiRegion: !Not [!Equals [!Ref PrimaryWebLoadBalancerDNS, ""]]

Resources:
  # Health Check for Primary Region ALB (multi-region only)
  PrimaryHealthCheck:
    Condition: IsMultiRegion
    Type: AWS::Route53::HealthCheck
    Properties:
      HealthCheckConfig:
        Type: HTTPS
        ResourcePath: /health
        FullyQualifiedDomainName: !Ref PrimaryWebLoadBalancerDNS
        Port: 443
        RequestInterval: 30
        FailureThreshold: 2
      HealthCheckTags:
        - Key: LogicalId
          Value: PrimaryHealthCheck
        - Key: Environment
          Value: !Ref BranchName
        - Key: Purpose
          Value: Primary-Web-Failover

  # Health Check for Secondary Region ALB (multi-region only)
  SecondaryHealthCheck:
    Condition: IsMultiRegion
    Type: AWS::Route53::HealthCheck
    Properties:
      HealthCheckConfig:
        Type: HTTPS
        ResourcePath: /health
        FullyQualifiedDomainName:
          Fn::ImportValue: !Sub "WebLoadBalancerDNS-${BranchName}"
        Port: 443
        RequestInterval: 30
        FailureThreshold: 2
      HealthCheckTags:
        - Key: LogicalId
          Value: SecondaryHealthCheck
        - Key: Environment
          Value: !Ref BranchName
        - Key: Purpose
          Value: Secondary-Web-Failover

  # Single Region: Simple A record pointing to local load balancer
  SingleRegionDNSRecord:
    Condition: IsSingleRegion
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneId: !Ref HostedZoneId
      Name: !Sub "${BranchName}.${DomainName}"
      Type: A
      AliasTarget:
        DNSName:
          Fn::ImportValue: !Sub "WebLoadBalancerDNS-${BranchName}"
        HostedZoneId:
          Fn::ImportValue: !Sub "WebLoadBalancerHostedZoneId-${BranchName}"

  # Multi-Region: PRIMARY failover record pointing to primary region's load balancer
  PrimaryFailoverDNSRecord:
    Condition: IsMultiRegion
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneId: !Ref HostedZoneId
      Name: !Sub "${BranchName}.${DomainName}"
      Type: A
      SetIdentifier: !Sub "primary-${BranchName}"
      Failover: PRIMARY
      AliasTarget:
        DNSName: !Ref PrimaryWebLoadBalancerDNS
        HostedZoneId: !Ref PrimaryWebLoadBalancerHostedZoneId
      HealthCheckId: !Ref PrimaryHealthCheck

  # Multi-Region: SECONDARY failover record pointing to secondary region's load balancer (current region)
  SecondaryFailoverDNSRecord:
    Condition: IsMultiRegion
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneId: !Ref HostedZoneId
      Name: !Sub "${BranchName}.${DomainName}"
      Type: A
      SetIdentifier: !Sub "secondary-${BranchName}"
      Failover: SECONDARY
      AliasTarget:
        DNSName:
          Fn::ImportValue: !Sub "WebLoadBalancerDNS-${BranchName}"
        HostedZoneId:
          Fn::ImportValue: !Sub "WebLoadBalancerHostedZoneId-${BranchName}"
      HealthCheckId: !Ref SecondaryHealthCheck

Outputs:
  WebEndpoint:
    Description: "Web application endpoint URL"
    Value: !Sub "https://${BranchName}.${DomainName}"

  PrimaryHealthCheckId:
    Description: "Primary health check ID (multi-region only)"
    Value: !If [IsMultiRegion, !Ref PrimaryHealthCheck, "N/A"]

  SecondaryHealthCheckId:
    Description: "Secondary health check ID (multi-region only)"
    Value: !If [IsMultiRegion, !Ref SecondaryHealthCheck, "N/A"]
