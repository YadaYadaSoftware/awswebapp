---
AWSTemplateFormatVersion: "2010-09-09"
Description: "Regional Infrastructure - ECS cluster + Google OAuth secrets. Secret paths derive the dashed-domain prefix from DomainName via Fn::Join+Fn::Split."

Parameters:
  GoogleOAuthClientId:
    Type: String
    Description: "Google OAuth Client ID"
    NoEcho: true

  GoogleOAuthClientSecret:
    Type: String
    Description: "Google OAuth Client Secret"
    NoEcho: true

  BranchName:
    Type: String
    Description: Branch name for resource naming

  DomainName:
    Type: String
    Description: "Domain name in dot form (e.g. appcloud.systems). Derived to dashed form locally."

Resources:
  # ECS Cluster
  ECSCluster:
    Type: AWS::ECS::Cluster
  # Google OAuth Secrets
  GoogleOAuthSecrets:
    Type: AWS::SecretsManager::Secret
    Properties:
      Name: !Sub
        - "${DomainDashed}/google-oauth/${BranchName}"
        - DomainDashed: !Join ["-", !Split [".", !Ref DomainName]]
      Description: "Google OAuth credentials for the web application"
      SecretString: !Sub |
        {
          "clientId": "${GoogleOAuthClientId}",
          "clientSecret": "${GoogleOAuthClientSecret}"
        }
Outputs:
  ECSClusterName:
    Description: "ECS cluster name"
    Value: !GetAtt ECSCluster.Arn
    Export:
      Name: !Sub "ECSClusterName-${BranchName}"

  GoogleOAuthSecretArn:
    Description: "ARN of the Google OAuth secrets"
    Value: !Ref GoogleOAuthSecrets
    Export:
      Name: !Sub "GoogleOAuthSecretArn-${BranchName}"
